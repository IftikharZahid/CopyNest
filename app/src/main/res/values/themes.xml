<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.CopyNest" parent="android:Theme.DeviceDefault.NoActionBar">
        <!-- Native window background with centered CopyNest app logo on white background -->
        <item name="android:windowBackground">@drawable/splash_window_background</item>

        <!-- Status bar and navigation bar: transparent with dark icons for white background -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="29">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="29">false</item>

        <!-- Android 12+ (API 31+) Native Splash Screen: white background + app logo -->
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/splash_background</item>
        <item name="android:windowSplashScreenAnimatedIcon" tools:targetApi="31">@drawable/ic_launcher_fg_art</item>
        <item name="android:windowSplashScreenIconBackgroundColor" tools:targetApi="31">#FFFFFFFF</item>
    </style>
</resources>
